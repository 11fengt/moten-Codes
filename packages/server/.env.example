# Copy to .env; never commit your real database password or JWT secret.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_local_password
DB_NAME=moten_codes

# Required: generate a random secret of at least 32 UTF-8 bytes (see README).
JWT_SECRET=

# Optional, only used by pnpm --filter @learn-moten/server init:user.
INIT_USERNAME=demo_user
INIT_PASSWORD=
